{
    "name": "yasinkuyu/omnipay-paytr",
    "type": "library",
    "description": "PayTR gateway for Omnipay: iFrame payment page, signed notification (callback) verification, refund, status inquiry",
    "keywords": ["paytr", "sanal pos", "iframe", "odeme", "omnipay", "gateway", "payment"],
    "homepage": "https://github.com/yasinkuyu/omnipay-paytr",
    "license": "MIT",
    "authors": [
        {"name": "Yasin Kuyu", "email": "yasinkuyu@gmail.com"},
        {"name": "Contributors", "homepage": "https://github.com/yasinkuyu/omnipay-paytr/contributors"}
    ],
    "autoload": {"psr-4": {"Omnipay\\PayTR\\": "src/"}},
    "autoload-dev": {"psr-4": {"Omnipay\\PayTR\\Tests\\": "tests/"}},
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "omnipay/common": "^3.3"
    },
    "require-dev": {
        "omnipay/tests": "^4.1",
        "php-http/guzzle7-adapter": "^1.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {"branch-alias": {"dev-3.x": "3.x-dev"}},
    "config": {"allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "dev",
    "prefer-stable": true
}
